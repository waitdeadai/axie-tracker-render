# Configuracion del servidor
PORT=4000
NODE_ENV=production
DATA_DIR=/data

# API Keys para la API de Origins
ORIGINS_API_KEYS=key1,key2,key3,key4,key5
ORIGINS_API_KEY_HEADER=X-API-Key

# URLs para las APIs
LEADERBOARD_URL=https://api-gateway.skymavis.com/origins/v2/season-leaderboards
BATTLE_LOG_URL=https://api-gateway.skymavis.com/origin/v2/community/users/:client_id/battle-logs
AXIE_TOP_URL=https://axie.top/

# Ventanas y caching
ACTIVE_WINDOW_MS=300000
REFRESH_LEADERBOARD_MS=20000
BATTLELOG_TTL_MS=45000
IMAGES_TTL_MS=300000

# Presupuesto de rate limit
KEYS=5
KEY_RPS=5
KEY_RPM=100
BUDGET_RPM=450
BUDGET_RPS=7.5

# Capa global Bottleneck
GLOBAL_RESERVOIR=450
GLOBAL_REFRESH_MS=60000
REQUEST_TIMEOUT_MS=10000

# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=tu_client_id_aqui
DISCORD_CLIENT_SECRET=tu_client_secret_aqui
DISCORD_CALLBACK_URL=https://axie-mvp-backend.fly.dev/api/auth/discord/callback
SESSION_SECRET=genera_un_secreto_seguro_aqui
JWT_SECRET=genera_otro_secreto_seguro_aqui
FRONTEND_URL=https://axie-mvp.vercel.app

# Discord Whitelist
ALLOWED_DISCORD_IDS=969845195988410388,429035818087219200,868483231228514385

# CORS Configuration
CORS_ORIGIN=https://axie-mvp.vercel.app
